{
  "name": "dshome-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/syntax-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "mind-check": "node scripts/mind-validate.mjs --strict",
    "host-check": "node scripts/verify-host-plugins.mjs",
    "guard-check": "node scripts/verify-guard-decisions.mjs",
    "shell-check": "node scripts/verify-safe-overlay.mjs",
    "verify": "pnpm build && pnpm smoke && node scripts/mind-validate.mjs --strict && node scripts/verify-host-plugins.mjs && node scripts/verify-guard-decisions.mjs --allow-partial && node scripts/verify-safe-overlay.mjs && node scripts/verify-payload.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "install-hooks": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "publish": "pnpm -r publish",
    "setup": "node scripts/install-electron.mjs",
    "patch:icon": "node scripts/patch-electron-icon.mjs"
  },
  "dependencies": {
    "dshome": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-anonymous-user-id": "0.1.5-rc.2",
      "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
      "@deepseek-ai/dsh-authorization": "0.1.5-rc.2",
      "@deepseek-ai/dsh-bash-local": "0.1.5-rc.2",
      "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
      "@deepseek-ai/dsh-compaction": "0.1.5-rc.2",
      "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
      "@deepseek-ai/dsh-jobs": "0.1.5-rc.2",
      "@deepseek-ai/dsh-output-retention": "0.1.5-rc.2",
      "@deepseek-ai/dsh-sandbox": "0.1.5-rc.2",
      "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
      "@deepseek-ai/dsh-session-query": "0.1.5-rc.2",
      "@deepseek-ai/dsh-session-telemetry": "0.1.5-rc.2",
      "@deepseek-ai/dsh-session-title-llm": "0.1.5-rc.2",
      "@deepseek-ai/dsh-shell": "0.1.5-rc.2",
      "@deepseek-ai/dsh-spill": "0.1.5-rc.2",
      "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.5-rc.2",
      "@deepseek-ai/dsh-workflow": "0.1.5-rc.2"
    }
  }
}
