#!/bin/sh
# pre-commit — AGENTS §四 自我修改硬流程的「机器强制」（2026-09-11 建）
#
# ── 为什么需要它 ─────────────────────────────────────────────────────────────
# AGENTS §四 要求：① 主人放行 ② 改前快照 ③ 改后 `mind-validate` 通过，任一不满足不落盘。
# 但 2026-09-11 盲评实测：**只有 ① 被 mind-guard 强制**——②③ 既无 hook 也无任何代码调用，
# 全靠"agent 记得跑"。本 hook 让「不通过不落盘」从纪律变成**机器事实**（③ 这一半）。
#
# ── 做这些事 ─────────────────────────────────────────────────────────────────
#   ① scripts/syntax-check.mjs             —— 语法检查（= `pnpm build` 的实质内容）
#   ② scripts/mind-validate.mjs --strict   —— 记忆层布局/出厂卫生/版本四元/概念路由… 有 critical 或 warn 即拒
#   ③ scripts/verify-host-plugins.mjs      —— host 插件「挂载面」真加载验证
#      （`node --check` 只查语法、查不出未定义标识符：2026-09-11 一夜之间同型 bug 两例——
#        mind-inject.js 的 `payload.length`、mind-skill-loader.js 的 `skills.length`，
#        两者都被 apply 的 try/catch 吞成 warn，效果面正常、挂载面全坏）
#   ④ verify-guard-decisions --allow-partial —— 门禁判定真值表（见下）
#   ⑤ scripts/verify-safe-overlay.mjs      —— 安全模式覆盖层「CLI == 外壳」同口径（2026-09-11 加）
#   ⑥ scripts/verify-scripts-run.mjs       —— 工具脚本「真跑冒烟」（2026-09-11 加；补 scripts/ 这一面）
#   ⑦ scripts/verify-payload.mjs           —— payload 新鲜度 / 毒树 / 私有面（2026-09-12 加：打包快照不许带旧代码）
#   ⑧ scripts/verify-trash.mjs             —— TRASH 回收站真值表 10 例（2026-09-12 加；每例独立临时 DSH_HOME ⇒ 真仓库零触碰）
#   ⑨ scripts/backup-settings.mjs          —— settings.yaml 留档（私有区；**非阻塞**，见下）
#   ⑩ scripts/verify-compaction-log.mjs    —— 压缩留痕真值表 14 例（2026-09-12 加；真 cordis + 临时 DSH_HOME）
#
# ── 逃生门 ───────────────────────────────────────────────────────────────────
#   `git commit --no-verify`：仅在**明确知情**时用（例如正在修的正是校验器本身）。
#   ⚠️ ②「改前快照」仍无机器强制（快照与否是历史事实，hook 判不了）；那半步靠 §四 纪律 + 面板放行时的自觉。
#
# 装法：cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -e
cd "$(git rev-parse --show-toplevel)"
# ① 语法检查（= `pnpm build` 的实质内容；直接调脚本，避免依赖 pnpm 在 PATH 上）
#    C2 指摘：原 hook 不跑 build/smoke/verify-payload → 非 host 插件的语法错误在提交时无门。
node scripts/syntax-check.mjs
# ② 心智校验（记忆层布局 / 出厂卫生 / 版本四元 / 概念路由…；有 critical 即拒）
node scripts/mind-validate.mjs --strict
# ③ host 插件挂载面（真加载 + 调 apply + handler 真跑 + 行为断言）
node scripts/verify-host-plugins.mjs
# 门禁判定真值表（2026-09-11 加）：autoApprove 开着时自动降级为「只跑 privacy 类用例」并明确标注，
# 不阻塞提交（那是环境状态、不是缺陷）；关着时跑全 17 例。
node scripts/verify-guard-decisions.mjs --allow-partial
# ④ 安全模式覆盖层口径（L3+L4 单一实现；2026-09-11 加）。
#    `safe.mjs` 曾是「只解析 L3」的第二实现——崩在 L4 行（agent-teams 三包 / dsh-imagegen）
#    时逃生通道恰好兜不住；本项锁「CLI 清单 == 外壳清单」。
node scripts/verify-safe-overlay.mjs
# ⑥ 工具脚本「真跑冒烟」（2026-09-11 加）：覆盖 scripts/ 这一面 —— `node --check` 查不出
#    未定义标识符与 TDZ（同型已复发 2 次：mind-inject.js 的 `payload.length`、
#    search-regression.mjs 的 `const top`，都是"语法全过、真跑才炸"）。
#    host 插件面已由 ③ 覆盖，本项补 scripts/ 面。只跑**安全白名单**（无参=只读/自检）；
#    有副作用的脚本（stage-payload / install-hooks / backup-settings / patch-* …）跳过并**显式打印**，不静默。
node scripts/verify-scripts-run.mjs
# ⑦ payload 新鲜度（2026-09-12 加）：源码改了而 `build-stage/payload` 没同步 ⇒ 装机版**带旧代码出门**。
#    实测：payload 里两份 host 插件仍是修复前 `form:'skill-hint'` 版本——正是"让 46 个会话历史加载失败"
#    的旧 source，而该漂移当时只算 WARN、本脚本又不在任何门禁链里（两道门禁都看不见）。
#    mind/packages/scripts 漂移即拒（docs 仍 WARN）；修复办法：先 `node scripts/stage-payload.mjs` 再提交。
#    未 staging（payload 目录不存在）时脚本自行 exit 0 ⇒ 不拦纯开发提交。
node scripts/verify-payload.mjs
# ⑧ TRASH 回收站真值表（2026-09-12 加）：建 `evolve-log trash` 时我**手工**跑过 8 项测试并抓到 1 个真 bug
#    （缺 `--reason` 时误报"用法"而非"必须给理由"）—— 但那些测试是**一次性的**，跑完就没了。
#    本项把它机器化：10 例（含 4 个反例），每例一个**独立临时 DSH_HOME** ⇒ 真仓库的
#    `mind-private/TRASH/` 与 `changelog.md` 零触碰（脚本自带 `git status` 自证）。
#    已过「测试的测试」：故意短路 `--reason` 校验 ⇒ 用例 ② 变红；还原 ⇒ 10/10 回绿（**不是恒绿测试**）。
node scripts/verify-trash.mjs
# ⑨ settings.yaml 留档（私有区，幂等去重；2026-09-11 加）。
#    它是运行时配置、不在 git 里、DSH 启动可能整份重写 → 每次提交顺手留一档。
#    ⚠️ 备份是辅助不是门禁：失败只告警，不阻塞提交。
node scripts/backup-settings.mjs || echo "[pre-commit] ⚠️ settings 留档失败（不阻塞提交）"
# ⑩ 压缩留痕真值表（2026-09-12 加）：新落的 host 插件 `mind-compaction-log` 靠事件流写审计行，
#    而它的**第一版验证脚本用假 ctx**——假 ctx 正好绕过 cordis 的 inject 门（同一 bug 在测试里永远
#    看不见，9/9 绿、线上全是 `unknown`）。本项真跑 cordis：真 provide / 真 inject / 真事件发射，
#    14 例（含 4 个反例）+ 临时 DSH_HOME ⇒ 真仓库与真日志零触碰。
#    已过「测试的测试」：在修复前的插件快照上复跑 ⇒ B/G×2/H 段变红（10/14，exit 1）。
node scripts/verify-compaction-log.mjs
