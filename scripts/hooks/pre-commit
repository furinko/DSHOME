#!/bin/sh
# pre-commit — AGENTS §四 自我修改硬流程的「机器强制」（2026-09-11 建）
#
# ── 为什么需要它 ─────────────────────────────────────────────────────────────
# AGENTS §四 要求：① 主人放行 ② 改前快照 ③ 改后 `mind-validate` 通过，任一不满足不落盘。
# 但 2026-09-11 盲评实测：**只有 ① 被 mind-guard 强制**——②③ 既无 hook 也无任何代码调用，
# 全靠"agent 记得跑"。本 hook 让「不通过不落盘」从纪律变成**机器事实**（③ 这一半）。
#
# ── 做这些事 ─────────────────────────────────────────────────────────────────
#   ① scripts/syntax-check.mjs             —— 语法检查（= `pnpm build` 的实质内容）
#   ② scripts/mind-validate.mjs --strict --defer-content-drift —— 记忆层布局/出厂卫生/版本四元/概念路由… 有 critical 或 warn 即拒；
#      末尾开关只把「payload\AGENTS.md 快照漂移」的判定推迟到打包时（2026-09-23 主人放行「改」，详见 ② 接线处说明）
#   ③ scripts/verify-host-plugins.mjs      —— host 插件「挂载面」真加载验证
#      （`node --check` 只查语法、查不出未定义标识符：2026-09-11 一夜之间同型 bug 两例——
#        mind-inject.js 的 `payload.length`、mind-skill-loader.js 的 `skills.length`，
#        两者都被 apply 的 try/catch 吞成 warn，效果面正常、挂载面全坏）
#   ④ verify-guard-decisions --allow-partial —— 门禁判定真值表（见下）
#   ⑤ scripts/verify-safe-overlay.mjs      —— 安全模式覆盖层「CLI == 外壳」同口径（2026-09-11 加）
#   ⑥ scripts/verify-scripts-run.mjs       —— 工具脚本「真跑冒烟」（2026-09-11 加；补 scripts/ 这一面）
#   ⑦ scripts/verify-payload.mjs           —— payload 新鲜度 / 毒树 / 私有面（2026-09-12 加：打包快照不许带旧代码）
#   ⑧ scripts/verify-trash.mjs             —— TRASH 回收站真值表 10 例（2026-09-12 加；每例独立临时 DSH_HOME ⇒ 真仓库零触碰）
#   ⑨ scripts/backup-settings.mjs          —— settings.yaml 留档（私有区；**非阻塞**，见下）
#   ⑩ scripts/verify-compaction-log.mjs    —— 压缩留痕真值表 14 例（2026-09-12 加；真 cordis + 临时 DSH_HOME）
#   ⑪ scripts/growth-audit.mjs             —— 增长面看门狗（2026-09-12 加；只有 hard 才拦：环 marker 被改坏 / 越硬线）
#   ⑫ scripts/gate-ledger.mjs --check      —— 门禁反证台账（2026-09-12 加；棘轮：新 verify-* 零反证痕迹即拒）
#
# ── 逃生门 ───────────────────────────────────────────────────────────────────
#   `git commit --no-verify`：仅在**明确知情**时用（例如正在修的正是校验器本身）。
#   ⚠️ ②「改前快照」仍无机器强制（快照与否是历史事实，hook 判不了）；那半步靠 §四 纪律 + 面板放行时的自觉。
#
# 装法：cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -e
cd "$(git rev-parse --show-toplevel)"
# ① 语法检查（= `pnpm build` 的实质内容；直接调脚本，避免依赖 pnpm 在 PATH 上）
#    C2 指摘：原 hook 不跑 build/smoke/verify-payload → 非 host 插件的语法错误在提交时无门。
node scripts/syntax-check.mjs
# ② 心智校验（记忆层布局 / 出厂卫生 / 版本四元 / 概念路由…；有 critical 即拒）
#    `--defer-content-drift`（2026-09-23 主人放行「改」）：只把 ⑦(c)「payload\AGENTS.md
#    快照漂移」这条 warn 的判定推迟到打包时（与 ⑦ verify-payload 同口径）；其余项照旧。
node scripts/mind-validate.mjs --strict --defer-content-drift
# ③ host 插件挂载面（真加载 + 调 apply + handler 真跑 + 行为断言）
node scripts/verify-host-plugins.mjs
# 门禁判定真值表（2026-09-11 加）：autoApprove 开着时自动降级为「只跑 privacy 类用例」并明确标注，
# 不阻塞提交（那是环境状态、不是缺陷）；关着时跑全 17 例。
node scripts/verify-guard-decisions.mjs --allow-partial
# ④ 安全模式覆盖层口径（L3+L4 单一实现；2026-09-11 加）。
#    `safe.mjs` 曾是「只解析 L3」的第二实现——崩在 L4 行（agent-teams 三包 / dsh-imagegen）
#    时逃生通道恰好兜不住；本项锁「CLI 清单 == 外壳清单」。
node scripts/verify-safe-overlay.mjs
# ⑥ 工具脚本「真跑冒烟」（2026-09-11 加）：覆盖 scripts/ 这一面 —— `node --check` 查不出
#    未定义标识符与 TDZ（同型已复发 2 次：mind-inject.js 的 `payload.length`、
#    search-regression.mjs 的 `const top`，都是"语法全过、真跑才炸"）。
#    host 插件面已由 ③ 覆盖，本项补 scripts/ 面。只跑**安全白名单**（无参=只读/自检）；
#    有副作用的脚本（stage-payload / install-hooks / backup-settings / patch-* …）跳过并**显式打印**，不静默。
node scripts/verify-scripts-run.mjs
# ⑦ payload 门禁（2026-09-12 加；2026-09-23 **收窄判定时机**——主人放行「改」）：
#    它管两件事，风险点不同、处置也不同：
#      ⓐ 毒树 junction / 版本单源 / 私有面残留 / AGENTS 快照 —— 错误状态与双区红线 ⇒ **照旧硬拦**；
#      ⓑ 内容漂移（源码改了而 `build-stage/payload` 没同步 ⇒ 装机版**带旧代码出门**）
#         —— 风险点在**装箱**不在**存档** ⇒ 日常提交不再拦。依据＝主人偏好「payload 陈旧
#         只在我要打包时提醒」（`mind-private/L3/common/user-rules/rules.md:73`）。
#    所以本行带 `--defer-content-drift`：只跳过 ⓑ 整类（不判、不打印）；
#    打包 / 显式验证（`pnpm verify`、不带该参数）**仍然硬拦**并给出 stage-payload 指引。
#    未 staging（payload 目录不存在）时脚本自行 exit 0 ⇒ 不拦纯开发提交。
node scripts/verify-payload.mjs --defer-content-drift
# ⑧ TRASH 回收站真值表（2026-09-12 加）：建 `evolve-log trash` 时我**手工**跑过 8 项测试并抓到 1 个真 bug
#    （缺 `--reason` 时误报"用法"而非"必须给理由"）—— 但那些测试是**一次性的**，跑完就没了。
#    本项把它机器化：10 例（含 4 个反例），每例一个**独立临时 DSH_HOME** ⇒ 真仓库的
#    `mind-private/TRASH/` 与 `changelog.md` 零触碰（脚本自带 `git status` 自证）。
#    已过「测试的测试」：故意短路 `--reason` 校验 ⇒ 用例 ② 变红；还原 ⇒ 10/10 回绿（**不是恒绿测试**）。
node scripts/verify-trash.mjs
# ⑨ settings.yaml 留档（私有区，幂等去重；2026-09-11 加）。
#    它是运行时配置、不在 git 里、DSH 启动可能整份重写 → 每次提交顺手留一档。
#    ⚠️ 备份是辅助不是门禁：失败只告警，不阻塞提交。
node scripts/backup-settings.mjs || echo "[pre-commit] ⚠️ settings 留档失败（不阻塞提交）"
# ⑩ 压缩留痕真值表（2026-09-12 加）：新落的 host 插件 `mind-compaction-log` 靠事件流写审计行，
#    而它的**第一版验证脚本用假 ctx**——假 ctx 正好绕过 cordis 的 inject 门（同一 bug 在测试里永远
#    看不见，9/9 绿、线上全是 `unknown`）。本项真跑 cordis：真 provide / 真 inject / 真事件发射，
#    14 例（含 4 个反例）+ 临时 DSH_HOME ⇒ 真仓库与真日志零触碰。
#    已过「测试的测试」：在修复前的插件快照上复跑 ⇒ B/G×2/H 段变红（10/14，exit 1）。
node scripts/verify-compaction-log.mjs
# ⑪ 增长面看门狗（2026-09-12 加，收编自 CH4 v1.0.4「5MB 日志轮转」一课）：实测**我们自己的记录面本来就有界**
#    （guard / inject marker 是 `slice(-20)` 环、recall / skill-loader 单行、`snapshots` 有时间窗、
#    `TRASH` 有回收流程），真正无界的是**第三方** `dshmarket` 写的 `.dsh-market\log.ndjson`
#    （它没有轮转机制、我们的代码改不了它）⇒ **不造冗余轮转**，改把这些体积变成机器可见：
#      hard = 我们自己的机制坏了（如 marker 环超行数）→ **拦**； warn = 体积增长 / 第三方面 → 只提醒。
node scripts/growth-audit.mjs
# ⑫ 门禁反证台账（2026-09-12 加，收编自 CH4「负例谱独立成文件」一课）：CH4 的"应当失败"用例是长期在库的
#    文件谱；我们这边反证一直是**内联断言 + 一次性手工实验**（09-12 当天就有两例手工反证，跑完就没了）。
#    本项把"每个 verify-* 有没有反证"做成机器台账并设**棘轮**：4 个历史门禁允许暂时为零，
#    **新 `verify-*` 零反证痕迹即拒**。逃生标记：`// gate-ledger: reverse-cases <反证在哪>`。
node scripts/gate-ledger.mjs --check
# ⑬ 检索回归门禁（2026-09-17 加 · **2026-09-20 改跑「装置层」**）
#    ⚠️ 分层（2026-09-20 S2）：本条**只跑 `--layer=factory`（装置回归）** —— 题集与语料都取自出厂面
#    （`scripts/regression-set.factory.json` + `mind/**`），**输入自足** ⇒ 基线可随仓库走、跨设备同源、**真拦**。
#    私人层（`mind-private/L3` 活库）分母**每天都在变** ⇒ **不进链、只报不拦**（拦下来必是假红）。
#    为什么改：原实现把「读数」放受管区、把「输入」留私有区 ⇒ 换设备/新克隆必然参照值不匹配、恒 exit 2；
#    两边各自 `--update-baseline` 又互相覆盖（ping-pong）。判据＝**出厂面的东西必须自足**。
#      0 = 不劣于基线 / 语料增量（日常增删出厂文档**不堵门**）
#      1 = **真退化**（召回或第一名低于 `scripts/regression-baseline.factory.json`）
#      2 = **条件变了需重建**（回归集条数变 / **锚点文件丢失** / 语料减少）
#      3 = **本机无装置基线**（响亮；先跑一次 `--layer=factory --update-baseline` 建立）
#    `HINDSIGHT_NO_METRICS=1`：门禁**不得**改被测对象的指标（不 bump / 不落基线 / 不写 changelog）。
#    逃生门：规则或语料大改时 `git commit --no-verify`，或先手工 `--layer=factory --update-baseline` 重建后提交。
HINDSIGHT_NO_METRICS=1 node scripts/search-regression.mjs --layer=factory
# ⑭ 补齐链外门禁（2026-09-17 加 · 待办「门禁强制力」：原来 5 道 `verify-*` **根本不在链上** ⇒
#    绿提交可与红门禁并存）。本次把能绿的都挂进来，并逐个核过真实退出码：
#      · verify-upstream-contract —— 上游具名导出/槽位/官方行 id 是否还在。**挂链前先修了尺子**：
#        `settingsNamespace` 上游（0.1.5-rc.2）**从未导出**，而 `upstream.js:65` 早已用 `optionalFn`
#        兜底 + 同值退回 ⇒ 原脚本把它列进"必需"导致**恒红**（这正是它一直挂不上链的卡点）。现改为
#        "可选导出 + 断言我们的兜底存在"，并附**可执行反例**（去掉 upstream.js 的 optionalFn ⇒ 必红）。
#      · verify-l1-versions —— 新门禁：改 L1 规则正文**必须提版本**（`Ritual §四` 事务流程）。
#        判据＝staged 内容 vs HEAD 内容（无台账）；自带 `--selftest` 5 条可执行反例。同日实测漏项：
#        `Ritual`/`Power` 各改两次正文、两次都忘 +0.1（`mind-validate` 只管 L2 Skill 四元 ⇒ 盲区）。
#      · verify-pin-vs-installed —— profile 精确 pin ↔ node_modules 实体（治"git 同步了、依赖没同步"）。
#      · verify-boot-recall —— 上工召回注入链存在性（行为验收另跑 `mind-boot-recall-itest.mjs`）。
#      · verify-shell-readiness / verify-shell-autostart —— 外壳两道（就绪判据 / 开机自启登记口径，2026-09-17 建）。
node scripts/verify-upstream-contract.mjs
node scripts/verify-l1-versions.mjs
node scripts/verify-pin-vs-installed.mjs
node scripts/verify-boot-recall.mjs
node scripts/verify-shell-readiness.mjs
node scripts/verify-shell-autostart.mjs
# ⑮ Skill 版本五元（2026-09-17 加）：`skill-version --check` 此前**不在任何链上**——而 Skill 版本
#    写在五处（frontmatter / 文件尾 / `Tree.md` / `_index.md` / **`Skill\README.md` 能力表**），
#    全靠手工同步。README 那一处**两次漏登/落后**（09-11 漏 2 个技能 + 3 处版本；09-17 又漂 4 处），
#    根因就是"不在门禁面内"。本次把它接为第 5 元并挂链；`--selftest` 13 项（含 3 条 README 反例：
#    打坏版本 / 删行 / sync 复一致）可执行。
node scripts/skill-version.mjs --check
# ⑯ Web 产物补丁在位（2026-09-18 加；2026-09-24 扩第三块）：`scripts/patch-web-assets.mjs` 的三块补丁只改
#    **node_modules / payload 产物**（不在 git 里）——① `vendor-*.js` 的 `singleTilde→false`
#    ② 权限图标表补 `mind-guard` 项 ③ 右栏宽度跨刷新保持（初始化读 localStorage + 拖拽写回）。
#    `pnpm install` / 升级上游会**抹掉**它们，而首版收工时
#    它**不在任何链上** ⇒ 补丁可**静默消失**且无人喊（同「门禁不在链上 = 纸面门禁」一课）。
#    可执行反例：`pnpm install` 后直接跑 ⇒ 报未打 + exit 1；修复＝`node scripts/patch-web-assets.mjs`
#    （`stage-payload` 也会自动打）。薄包装，真源判据在 patcher 里。
node scripts/verify-web-patches.mjs
# ⑰ 卡线两支套件直挂（2026-09-25 加）：`verify-agent-roles.mjs` / `verify-agent-roles-card-tools.mjs`
#    此前**不在提交链的必跑面** —— 前者只在「真跑冒烟」（⑥）的 SAFE 白名单里，而该步**默认只跑暂存脚本**
#    （`--all` 才全量）⇒ 改插件而它不在暂存区时**永不执行**；后者是新件、同理。
#    代价当场发生过：插件注册面 3→6 把，`verify-agent-roles` 里写死的 `exactly three tools registered`
#    变红（248/249），而 pre-commit **全绿放行**（同型第三次：⑮ `skill-version`、⑯ `web-patches` 都栽在
#    "挂进白名单被当成挂上链"）。⇒ 判据落成"这两支必须**每次都跑**"，与暂存区无关。
#    反例可执行：把 `verify-agent-roles-card-tools.mjs` 任一断言改成必红 ⇒ 本链在 ⑰ 处 exit 1（已实测）。
node scripts/verify-agent-roles.mjs
node scripts/verify-agent-roles-card-tools.mjs
